#!/usr/bin/env python3
"""Walk music folders and print one JSON object per audio file.

usage: omamusic-scan [--cache FILE] FOLDER...

Entries from the previous output (--cache) are reused when size and mtime
match, so only new or changed files are probed.
"""
import json
import os
import subprocess
import sys

AUDIO = {".mp3", ".flac", ".ogg", ".opus", ".m4a", ".aac", ".wav", ".wma", ".ape", ".wv", ".aiff"}
FFPROBE_TIMEOUT = 10


def load_cache(path):
    cache = {}
    if not path:
        return cache
    try:
        with open(path, encoding="utf-8") as f:
            for line in f:
                try:
                    entry = json.loads(line)
                except ValueError:
                    continue
                cache[entry.get("path")] = entry
    except OSError:
        pass
    return cache


def first_int(value):
    try:
        return int(str(value).split("/")[0])
    except ValueError:
        return 0


def probe(path):
    try:
        out = subprocess.run(
            ["ffprobe", "-v", "error", "-print_format", "json", "-show_format", path],
            capture_output=True,
            timeout=FFPROBE_TIMEOUT,
            check=True,
        ).stdout
        fmt = json.loads(out).get("format", {})
    except (subprocess.SubprocessError, ValueError, OSError) as err:
        print(f"omamusic-scan: skipping {path}: {err}", file=sys.stderr)
        return None
    tags = {k.lower(): v for k, v in fmt.get("tags", {}).items()}
    try:
        duration = float(fmt.get("duration", 0))
    except ValueError:
        duration = 0.0
    return {
        "title": tags.get("title", ""),
        "artist": tags.get("artist", ""),
        "album_artist": tags.get("album_artist", tags.get("albumartist", "")),
        "album": tags.get("album", ""),
        "track": first_int(tags.get("track", 0)),
        "disc": first_int(tags.get("disc", tags.get("discnumber", 0))),
        "duration": duration,
    }


def main(argv):
    cache_path = None
    folders = []
    it = iter(argv)
    for arg in it:
        if arg == "--cache":
            cache_path = next(it, None)
        else:
            folders.append(arg)
    cache = load_cache(cache_path)

    for folder in folders:
        for root, dirs, files in os.walk(folder, followlinks=True):
            dirs.sort()
            for name in sorted(files):
                if os.path.splitext(name)[1].lower() not in AUDIO:
                    continue
                path = os.path.join(root, name)
                try:
                    path.encode("utf-8")
                except UnicodeEncodeError:
                    print(f"omamusic-scan: skipping non-UTF-8 name {path!r}", file=sys.stderr)
                    continue
                try:
                    st = os.stat(path)
                except OSError:
                    continue
                size, mtime = st.st_size, int(st.st_mtime)
                entry = cache.get(path)
                if not (entry and entry.get("size") == size and entry.get("mtime") == mtime):
                    info = probe(path)
                    if info is None:
                        continue
                    entry = {"path": path, "size": size, "mtime": mtime, **info}
                print(json.dumps(entry, ensure_ascii=False), flush=True)


if __name__ == "__main__":
    main(sys.argv[1:])
