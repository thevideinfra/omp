#!/usr/bin/env python3
"""Reads a YouTube Music account for OMP, through ytmusicapi.

    omp-ytm login     stdin: a pasted "Copy as cURL" (or the raw request headers); prints the login (JSON)
    omp-ytm browsers  prints the browser profiles that could hold a login: [{"label", "spec"}]
    omp-ytm check     stdin: the login; prints {"ok": true, "name": ...}
    omp-ytm sync      stdin: the login; prints JSON lines: progress, tracks and playlists
    omp-ytm search Q [N]  stdin: the login; prints JSON lines: up to N (default 40) tracks and albums that match Q
    omp-ytm history   stdin: the login; prints the songs played lately (most recent first, each once)
    omp-ytm album ID  stdin: the login; prints the tracks of the album with that browse id
    omp-ytm playlist-create TITLE [VIDEO...] | playlist-add ID VIDEO... | playlist-remove ID VIDEO/SETID...
    omp-ytm playlist-rename ID TITLE | playlist-delete ID | like VIDEO... | unlike VIDEO... | like-album BROWSE_ID
                      stdin: the login; each prints {"ok": true, ...} or fails

The login is either the JSON of `login` or a browser spec, "browser:<browser>:<profile folder>" (as printed
by `browsers`): the cookies are then read from that browser's profile on every run, so they stay fresh.

Errors go to stderr as one JSON line {"code": "auth" | "missing" | "other", "error": ...}; the exit code
is 2 for a login that no longer works, 3 for a missing module, 1 for anything else.
"""
import json
import os
import re
import shlex
import sys

AUTH, MISSING, OTHER = 2, 3, 1


def fail(code, exit_code, message):
    print(json.dumps({"code": code, "error": message}), file=sys.stderr)
    sys.exit(exit_code)


def headers_from_paste(text):
    """The header lines of a pasted cURL command, or the text itself when it is not one."""
    text = text.replace("\\\n", " ")
    if not text.lstrip().startswith("curl"):
        return text
    lines = []
    args = shlex.split(text)
    i = 0
    while i < len(args):
        if args[i] in ("-H", "--header") and i + 1 < len(args):
            lines.append(args[i + 1])
            i += 1
        elif args[i] in ("-b", "--cookie") and i + 1 < len(args):
            lines.append("cookie: " + args[i + 1])
            i += 1
        i += 1
    return "\n".join(lines)


BROWSERS = [  # (label, yt-dlp name, folder under ~/.config, "*" when every folder inside is a browser)
    ("Brave", "brave", "BraveSoftware/*"),
    ("Chromium", "chromium", "chromium"),
    ("Chrome", "chrome", "google-chrome"),
    ("Edge", "edge", "microsoft-edge"),
    ("Vivaldi", "vivaldi", "vivaldi"),
]


def find_browsers(home):
    """The browser profiles (with a cookie file) that could hold a YouTube Music login."""
    import glob
    out = []
    for label, name, folder in BROWSERS:
        for base in sorted(glob.glob(os.path.join(home, ".config", folder))):
            kind = os.path.basename(base).replace("-", " ") if "*" in folder else label
            for profile in sorted(os.listdir(base)) if os.path.isdir(base) else []:
                path = os.path.join(base, profile)
                if not (profile == "Default" or profile.startswith("Profile ")):
                    continue
                if os.path.exists(os.path.join(path, "Cookies")) or os.path.exists(os.path.join(path, "Network", "Cookies")):
                    out.append({"label": kind + ("" if profile == "Default" else " (%s)" % profile),
                                "spec": "browser:%s:%s" % (name, path)})
    for path in sorted(glob.glob(os.path.join(home, ".mozilla", "firefox", "*.default*"))):
        if os.path.exists(os.path.join(path, "cookies.sqlite")):
            out.append({"label": "Firefox", "spec": "browser:firefox:" + path})
    return out


def headers_from_browser(spec):
    """Request headers for music.youtube.com made from the cookies of a browser profile."""
    try:
        from yt_dlp.cookies import extract_cookies_from_browser
    except ImportError as e:
        fail("missing", MISSING, "yt-dlp is not installed (%s)" % e)
    _, name, profile = (spec.split(":", 2) + ["", ""])[:3]
    try:
        # Chromium-based browsers keep their cookie key in the Secret Service keyring; yt-dlp would guess the
        # keyring from the desktop and, on one it does not know (Hyprland), could not decrypt the cookies.
        jar = extract_cookies_from_browser(name, profile or None, keyring=None if name == "firefox" else "GNOMEKEYRING")
    except Exception as e:   # no such profile, a locked keyring, an unreadable file
        fail("other", OTHER, "cannot read the cookies of %s: %s" % (name, str(e)[:200]))
    # Only what a browser sends to music.youtube.com: Google keeps copies of the login cookies on google.com
    # with other values, and merging those in makes YouTube see a signed-out user. The most specific wins.
    host = "music.youtube.com"
    chosen = {}
    for c in jar:
        domain = c.domain.lstrip(".")
        if domain.count(".") < 1 or not (host == domain or host.endswith("." + domain)):
            continue
        rank = (len(domain), len(getattr(c, "path", "/") or "/"))
        if c.name not in chosen or rank > chosen[c.name][0]:
            chosen[c.name] = (rank, c.value)
    cookies = {name: value for name, (_, value) in chosen.items()}
    if "__Secure-3PAPISID" not in cookies and "SAPISID" not in cookies:
        fail("auth", AUTH, "not signed in to YouTube in that browser: open music.youtube.com there and sign in")
    return "\n".join([
        "cookie: " + "; ".join("%s=%s" % kv for kv in cookies.items()),
        "user-agent: Mozilla/5.0 (X11; Linux x86_64; rv:130.0) Gecko/20100101 Firefox/130.0",
        "accept: */*",
        "accept-language: en-US,en;q=0.5",
        "content-type: application/json",
        "x-goog-authuser: 0",
        "x-origin: https://music.youtube.com",
        "origin: https://music.youtube.com",
        # ytmusicapi takes headers without this for OAuth; it replaces the value on every request
        "authorization: SAPISIDHASH placeholder",
    ])


def bigger(url):
    """A larger picture for a Google thumbnail (=w60-h60-... becomes =w544-h544-...)."""
    return re.sub(r"=w\d+-h\d+", "=w544-h544", url) if "=w" in url else url


def track(raw, album=None, year=0, number=0, album_id=None, liked=False):
    video = raw.get("videoId")
    if not video or raw.get("isAvailable") is False:
        return None
    artists = [a["name"] for a in (raw.get("artists") or []) if a.get("name")]
    album_name = album or (raw.get("album") or {}).get("name") or "YouTube Music"
    thumbs = raw.get("thumbnails") or []
    out = {
        "kind": "track",
        "path": "ytm:" + video,
        "title": raw.get("title") or video,
        "artist": ", ".join(artists) or "Unknown",
        "album_artist": artists[0] if artists else "Unknown",
        "album": album_name,
        "track": number,
        "disc": 0,
        "duration": raw.get("duration_seconds") or 0,
        "size": 0,
        "mtime": 0,
    }
    if year or raw.get("year"):
        out["year"] = int(year or raw.get("year"))
    if thumbs:
        out["cover_id"] = bigger(thumbs[-1]["url"])
    if liked:
        out["starred"] = True
    album_id = (raw.get("album") or {}).get("id") or album_id
    if album_id:
        out["album_id"] = album_id
    return out


def album_tracks(api, browse_id):
    full = api.get_album(browse_id)
    out = []
    for n, raw in enumerate(full.get("tracks") or [], 1):
        raw.setdefault("album", {"name": full.get("title")})
        if not raw.get("thumbnails"):
            raw["thumbnails"] = full.get("thumbnails") or []
        t = track(raw, album=full.get("title"), year=full.get("year") or 0, number=raw.get("trackNumber") or n, album_id=browse_id)
        if t:
            out.append(t)
    return out


def history(api, limit=30):
    seen = set()
    for raw in api.get_history():
        t = track(raw)
        if t and t["path"] not in seen:
            seen.add(t["path"])
            emit(t)
            if len(seen) >= limit:
                break


def search(api, query, limit=40):
    if not query.strip():
        fail("other", OTHER, "nothing to search for")
    for raw in api.search(query, filter="songs", limit=limit):
        t = track(raw)
        if t:
            emit(t)
    for raw in api.search(query, filter="albums", limit=limit):
        if not raw.get("browseId"):
            continue
        thumbs = raw.get("thumbnails") or []
        out = {"kind": "album", "id": raw["browseId"], "title": raw.get("title") or "",
               "artist": ", ".join(a["name"] for a in (raw.get("artists") or []) if a.get("name")) or "Unknown",
               "year": int(raw.get("year") or 0), "type": raw.get("type") or "Album"}
        if thumbs:
            out["cover_id"] = bigger(thumbs[-1]["url"])
        emit(out)


def emit(obj):
    print(json.dumps(obj), flush=True)


def sync(api):
    seen = set()

    def add(raw, **kw):
        t = track(raw, **kw)
        if t and t["path"] not in seen:
            seen.add(t["path"])
            emit(t)
        return t["path"] if t else None

    liked = api.get_liked_songs(limit=None).get("tracks", [])
    for raw in liked:
        add(raw, liked=True)
    for raw in api.get_library_songs(limit=None):
        add(raw)
    albums = api.get_library_albums(limit=None)
    playlists = [p for p in api.get_library_playlists(limit=None) if p.get("playlistId") not in ("SE",)]
    total = len(albums) + len(playlists)
    done = 0
    for a in albums:
        try:
            tracks = album_tracks(api, a["browseId"])
        except Exception:
            tracks = []   # one album that will not open does not stop the rest
        for t in tracks:
            if t["path"] not in seen:
                seen.add(t["path"])
                emit(t)
        done += 1
        emit({"kind": "progress", "done": done, "total": total})
    for p in playlists:
        pid = p.get("playlistId")
        owned = False
        try:
            if pid == "LM":
                tracks = liked
            else:
                full = api.get_playlist(pid, limit=None)
                tracks, owned = full.get("tracks", []), bool(full.get("owned"))
        except Exception:
            tracks = []
        items = [(x, raw.get("setVideoId") or "") for raw in tracks for x in [add(raw)] if x]
        emit({"kind": "playlist", "id": pid, "name": p.get("title") or pid, "paths": [i[0] for i in items],
              "set_ids": [i[1] for i in items], "editable": owned and pid not in ("LM", "SE")})
        done += 1
        emit({"kind": "progress", "done": done, "total": total})


def check_status(result, what):
    status = result.get("status") if isinstance(result, dict) else result
    if status not in (None, "STATUS_SUCCEEDED") and not isinstance(status, dict):
        fail("other", OTHER, "%s was refused (%s)" % (what, status))


def set_ids(result):
    """{video id: setVideoId} from the answer to adding songs to a playlist."""
    out = {}
    for e in (result.get("playlistEditResults") or []) if isinstance(result, dict) else []:
        d = e.get("playlistEditVideoAddedResultData", e)
        if d.get("videoId"):
            out[d["videoId"]] = d.get("setVideoId") or ""
    return out


def edit(api, command, args):
    if command == "playlist-create":
        if not args or not args[0].strip():
            fail("other", OTHER, "a playlist needs a name")
        ids = args[1:]
        pid = api.create_playlist(args[0], "", video_ids=ids or None)
        if not isinstance(pid, str):
            fail("other", OTHER, "the playlist was not created: %s" % (pid,))
        out = {"ok": True, "id": pid, "set_ids": {}}
        if ids:
            out["set_ids"] = {t["videoId"]: t.get("setVideoId") or "" for t in api.get_playlist(pid, limit=None).get("tracks", []) if t.get("videoId")}
        return out
    if command == "playlist-add":
        result = api.add_playlist_items(args[0], args[1:], duplicates=False)
        check_status(result, "adding the songs")
        return {"ok": True, "set_ids": set_ids(result)}
    if command == "playlist-remove":
        pairs = [a.split("/", 1) for a in args[1:]]
        check_status(api.remove_playlist_items(args[0], [{"videoId": v, "setVideoId": s} for v, s in pairs]), "removing the songs")
        return {"ok": True}
    if command == "playlist-rename":
        check_status(api.edit_playlist(args[0], title=args[1]), "renaming the playlist")
        return {"ok": True}
    if command == "playlist-delete":
        check_status(api.delete_playlist(args[0]), "deleting the playlist")
        return {"ok": True}
    if command in ("like", "unlike"):
        for video in args:
            api.rate_song(video, "LIKE" if command == "like" else "INDIFFERENT")
        return {"ok": True}
    if command == "like-album":
        audio = api.get_album(args[0]).get("audioPlaylistId")
        if not audio:
            fail("other", OTHER, "that album has no playlist to add to the library")
        api.rate_playlist(audio, "LIKE")
        return {"ok": True}
    fail("other", OTHER, "unknown command %r" % command)


EDITS = ("playlist-create", "playlist-add", "playlist-remove", "playlist-rename", "playlist-delete", "like", "unlike", "like-album")


def main():
    command = sys.argv[1] if len(sys.argv) > 1 else ""
    if command == "browsers":   # needs no module, so it works before ytmusicapi is installed
        print(json.dumps(find_browsers(os.path.expanduser("~"))))
        return
    stdin = sys.stdin.read()
    try:
        from ytmusicapi import YTMusic
        from ytmusicapi.auth.browser import setup_browser
        from ytmusicapi.exceptions import YTMusicServerError, YTMusicUserError
    except ImportError as e:
        fail("missing", MISSING, "python-ytmusicapi is not installed (%s)" % e)
    try:
        if command == "login":
            print(setup_browser(None, headers_from_paste(stdin)))
        elif command in ("check", "sync", "search", "album", "history") + EDITS:
            login = stdin.strip()
            if login.startswith("browser:"):
                login = setup_browser(None, headers_from_browser(login))
            api = YTMusic(login)
            argument = sys.argv[2] if len(sys.argv) > 2 else ""
            if command == "check":
                emit({"ok": True, "name": api.get_account_info().get("accountName", "")})
            elif command == "history":
                history(api)
            elif command == "search":
                extra = sys.argv[3] if len(sys.argv) > 3 else ""
                search(api, argument, int(extra) if extra.isdigit() else 40)
            elif command == "album":
                for t in album_tracks(api, argument):
                    emit(t)
            elif command in EDITS:
                emit(edit(api, command, sys.argv[2:]))
            else:
                sync(api)
        else:
            fail("other", OTHER, "unknown command %r" % command)
    except (YTMusicUserError, YTMusicServerError) as e:
        message = str(e)
        auth = isinstance(e, YTMusicUserError) or re.search(r"\b(401|403)\b|unauthor|sign in|logged", message, re.I)
        fail("auth" if auth else "other", AUTH if auth else OTHER, message)
    except Exception as e:  # network, an unexpected answer
        message = "%s: %s" % (type(e).__name__, e)
        # A login that has gone stale is answered with a "sign in" page, which ytmusicapi cannot read.
        if "signInEndpoint" in message or "Sign in to" in message:
            fail("auth", AUTH, "YouTube Music says you are signed out")
        fail("other", OTHER, message[:300])


if __name__ == "__main__":
    main()
